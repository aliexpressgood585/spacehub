# ─── Client (VITE_*) ────────────────────────────────────────────────────────
# Anything with a VITE_ prefix is inlined into the browser bundle. Never put a
# secret here — server-only values belong in the block below.

# Sign-in + observation-log cloud sync. Omit both and the site runs anonymously
# on localStorage, with the account UI hidden.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# NASA APOD / imagery. Falls back to NASA's shared DEMO_KEY when unset.
VITE_NASA_API_KEY=

# Optional: error reporting and ad slot. Both no-op when empty.
VITE_SENTRY_DSN=
VITE_ADSENSE_SLOT=

# ─── Server only (Vercel project env, never VITE_-prefixed) ─────────────────

# Stripe — premium checkout (api/create-checkout-session.ts) and the webhook.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_YEARLY=price_...

# Newsletter (api/subscribe.ts, api/newsletter.ts)
RESEND_API_KEY=re_...
RESEND_AUDIENCE_ID=

# Web push notifications (api/iss.ts). Generate with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
PUSH_SUPABASE_URL=
PUSH_SUPABASE_SERVICE_KEY=

# Pageview analytics store (api/analytics.ts)
ANALYTICS_SUPABASE_URL=
ANALYTICS_SUPABASE_ANON_KEY=

# Server-side NASA key for the api/ proxies, and the canonical origin used in
# Stripe redirect URLs. CRON_SECRET guards the scheduled endpoints in vercel.json.
NASA_API_KEY=
APP_URL=https://www.spacehubapp.com
CRON_SECRET=
